APP_NAME=AlphaInvest AI API
APP_VERSION=1.0.0
APP_ENV=local
APP_DEBUG=true
APP_API_V1_PREFIX=/api/v1
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL
# Para desarrollo local utiliza una contraseña propia.
# Nunca almacenes credenciales reales en este archivo.
APP_DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/alphainvest_db
APP_DATABASE_ECHO=false
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=10
APP_DATABASE_POOL_TIMEOUT=30
APP_DATABASE_POOL_RECYCLE=1800
APP_DATABASE_COMMAND_TIMEOUT=10

# SSL PostgreSQL
#
# Desarrollo local:
# APP_DATABASE_SSL_MODE=disable
#
# Producción / Supabase:
# APP_DATABASE_SSL_MODE=require
#
# Para validación completa del certificado puede utilizarse:
# APP_DATABASE_SSL_MODE=verify-full
# APP_DATABASE_SSL_CA_FILE=/ruta/al/certificado-ca.crt
#
# Valores válidos:
# disable | require | verify-ca | verify-full
APP_DATABASE_SSL_MODE=disable
APP_DATABASE_SSL_CA_FILE=

# MongoDB documental
APP_MONGODB_URI=mongodb://localhost:27017
APP_MONGODB_DATABASE=alphainvest_documents
APP_MONGODB_NEWS_COLLECTION=noticias
APP_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Autenticación y seguridad
# En producción debe utilizarse una clave aleatoria de al menos 32 caracteres.
APP_JWT_SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_DE_AL_MENOS_32_CARACTERES
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=30
APP_MAX_FAILED_LOGIN_ATTEMPTS=5
APP_LOGIN_LOCK_MINUTES=15
APP_DEFAULT_ROLE=INVERSIONISTA

# Proveedor financiero: Alpha Vantage
APP_ALPHA_VANTAGE_API_KEY=
APP_ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
APP_ALPHA_VANTAGE_TIMEOUT_SECONDS=15
APP_ALPHA_VANTAGE_OUTPUT_SIZE=compact

# Worker
APP_WORKER_ENABLED=false
APP_WORKER_RUN_ON_STARTUP=false
APP_WORKER_RUN_ONCE=false
APP_WORKER_TIMEZONE=America/Mexico_City

# Trabajo ejecutado cuando APP_WORKER_RUN_ONCE=true
APP_WORKER_RUN_ONCE_JOB=ACTUALIZAR_PRECIOS_DIARIOS

# Sincronización de precios
# Mantener una lista reducida mientras se utilice una API gratuita.
APP_WORKER_PRICE_SYNC_SYMBOLS=AAPL

# Simulaciones
APP_WORKER_SIMULATION_SOURCE_NAME=Alpha Vantage
APP_WORKER_SIMULATION_BATCH_SIZE=10

# Procesamiento de IA
APP_WORKER_AI_ANALYSIS_SOURCE_NAME=Yahoo Finance
APP_WORKER_AI_ANALYSIS_BATCH_SIZE=20
APP_WORKER_AI_ANALYSIS_LOCK_SECONDS=1800

# Scheduler
APP_WORKER_MAX_INSTANCES=1
APP_WORKER_MISFIRE_GRACE_SECONDS=300
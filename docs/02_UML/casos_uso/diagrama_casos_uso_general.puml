  package "Portafolios" {
    usecase "CU-019 Crear portafolio" as CU019
    usecase "CU-020 Administrar posiciones" as CU020
    usecase "CU-021 Consultar rendimiento" as CU021
  }

  package "Simulacion" {
    usecase "CU-022 Crear simulacion" as CU022
    usecase "CU-023 Ejecutar simulacion" as CU023
    usecase "CU-024 Guardar simulacion" as CU024
    usecase "CU-025 Comparar simulaciones" as CU025
    usecase "Calcular resultados" as UCSIMULAR
  }

  package "Inteligencia artificial" {
    usecase "CU-026 Analizar activo" as CU026
    usecase "CU-027 Clasificar riesgo" as CU027
    usecase "CU-028 Estimar tendencia" as CU028
    usecase "CU-029 Obtener recomendacion" as CU029
    usecase "CU-030 Consultar explicacion" as CU030
    usecase "CU-031 Consultar historial" as CU031
    usecase "Ejecutar modelos de IA" as UCIA
    usecase "Generar explicacion" as UCEXPLICAR
    usecase "Mostrar advertencia" as UCADVERTENCIA
  }

  package "Administracion" {
    usecase "CU-032 Consultar usuarios" as CU032
    usecase "CU-033 Administrar usuarios" as CU033
    usecase "CU-034 Consultar auditoria" as CU034
    usecase "CU-035 Consultar errores" as CU035
    usecase "CU-036 Consultar estadisticas" as CU036
    usecase "CU-037 Consultar servicios" as CU037
    usecase "CU-038 Consultar modelos" as CU038
  }

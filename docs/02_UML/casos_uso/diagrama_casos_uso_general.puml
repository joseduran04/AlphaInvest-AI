@startuml
title AlphaInvest AI - Casos de Uso

left to right direction

actor "Usuario inversionista" as USR
actor "Administrador" as ADM
actor "API financiera" as FIN
actor "API de noticias" as NEWS
actor "Servicio de correo" as MAIL

rectangle "AlphaInvest AI" {

  package "Autenticacion" {
    usecase "CU-001 Registrar usuario" as CU001
    usecase "CU-002 Iniciar sesion" as CU002
    usecase "CU-003 Cerrar sesion" as CU003
    usecase "CU-004 Recuperar acceso" as CU004
    usecase "CU-005 Consultar perfil" as CU005
    usecase "CU-006 Actualizar perfil" as CU006
    usecase "Validar credenciales" as UCVALIDAR
    usecase "Enviar correo" as UCMAIL
  }

  package "Perfil de inversion" {
    usecase "CU-007 Completar cuestionario" as CU007
    usecase "CU-008 Consultar perfil de riesgo" as CU008
    usecase "Calcular perfil de riesgo" as UCPERFIL
  }

  package "Mercado" {
    usecase "CU-009 Buscar activo" as CU009
    usecase "CU-010 Consultar empresa" as CU010
    usecase "CU-011 Consultar historico" as CU011
    usecase "CU-012 Consultar indicadores" as CU012
    usecase "CU-013 Comparar activos" as CU013
    usecase "Consultar datos financieros" as UCMERCADO
  }

  package "Noticias" {
    usecase "CU-014 Consultar noticias" as CU014
    usecase "CU-015 Filtrar noticias" as CU015
    usecase "CU-016 Consultar sentimiento" as CU016
    usecase "Obtener noticias externas" as UCNEWS
  }

  package "Watchlist" {
